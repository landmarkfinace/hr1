generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  avatar    String?
  roleId    String?
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessions             Session[]
  operatedTransactions Transaction[] @relation("Operator")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   @default("[]") // JSON string array; ["*"] = all permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Setting {
  key   String @id
  value String
}

model Client {
  id            String    @id @default(cuid())
  name          String    @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  city          String?
  crNumber      String? // Saudi commercial registration number
  status        String    @default("active") // active | inactive
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects Project[]

  @@index([status])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  managerName String
  location    String?
  status      String        @default("active") // active | inactive | completed
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  staff        ProjectStaff[]
  attendances  Attendance[]
  payrolls     Payroll[]
  transactions Transaction[]

  @@index([status])
  @@index([clientId])
}

model StaffCategory {
  id          String       @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  staff Staff[]
}

model Staff {
  id                 String         @id @default(cuid())
  fullName           String
  phone              String?
  position           String?
  staffCategoryId    String?
  staffCategory      StaffCategory? @relation(fields: [staffCategoryId], references: [id], onDelete: SetNull)
  iqamaId            String         @unique
  iqamaExpiry        DateTime?
  passportExpiry     DateTime?
  joiningDate        DateTime?
  ratePerHour        Float          @default(0)
  overtimeRate       Float          @default(0)
  monthlySalary      Float          @default(0)
  profilePhoto       String?
  residentialAddress String?
  status             String         @default("active") // active | inactive
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  projects    ProjectStaff[]
  attendances Attendance[]
  payrolls    Payroll[]

  @@index([staffCategoryId])
  @@index([status])
}

model ProjectStaff {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([projectId, staffId])
  @@index([staffId])
}

model Attendance {
  id              String    @id @default(cuid())
  staffId         String
  staff           Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  checkIn         DateTime
  checkOut        DateTime?
  durationMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([staffId])
  @@index([projectId])
  @@index([checkIn])
}

model Payroll {
  id                  String   @id @default(cuid())
  staffId             String
  staff               Staff    @relation(fields: [staffId], references: [id])
  projectId           String?
  project             Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  month               Int // 1-12
  year                Int
  totalHours          Float
  hourlyRateSnapshot  Float
  overtimeHours       Float    @default(0)
  overtimeRateSnapshot Float   @default(0)
  otherEarnings       Float    @default(0)
  advance             Float    @default(0)
  absentPenalty       Float    @default(0)
  ptAmount            Float    @default(0)
  unionFees           Float    @default(0)
  otherDeductionValue Float    @default(0)
  otherDeductionType  String   @default("fixed") // fixed | percent
  grossPay            Float
  totalDeductions     Float
  netPay              Float
  status              String   @default("pending") // pending | paid
  payDate             DateTime?
  payType             String   @default("bank_transfer") // bank_transfer | cash | cheque
  taxCode             String   @default("N/A")
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  salaryTransaction   Transaction?

  @@unique([staffId, projectId, month, year])
  @@index([staffId, month, year])
  @@index([projectId])
  @@index([month, year])
}

model TransactionCategory {
  id        String   @id @default(cuid())
  name      String
  type      String // income | expense
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([type])
}

model Transaction {
  id                    String              @id @default(cuid())
  type                  String // income | expense
  title                 String
  amount                Float
  transactionCategoryId String
  transactionCategory   TransactionCategory @relation(fields: [transactionCategoryId], references: [id])
  projectId             String?
  project               Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  operatorUserId        String?
  operator              User?               @relation("Operator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  transactionDate       DateTime
  description           String?
  payrollId             String?             @unique
  payroll               Payroll?            @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([type, transactionDate])
  @@index([projectId])
  @@index([transactionCategoryId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  action      String // created | updated | deleted | paid | login
  module      String // payroll | transaction | staff | project | staff_category | user | role | settings
  description String
  amount      Float?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
